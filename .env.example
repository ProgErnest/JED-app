# --- Fichier modèle pour les variables d'environnement ---
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne jamais committer le fichier .env contenant les secrets réels.

# Clé secrète Django (obligatoire en production, générée avec :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=changez-moi-en-production

# Hôtes autorisés en production (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Chemin de la base de données SQLite (facultatif, sinon utilise db.sqlite3 à la racine)
# DJANGO_DB_PATH=/var/www/jed/db.sqlite3

# HTTPS
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

# Email (SMTP)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=JED <noreply@votre-domaine.cm>

# Niveau de logging
DJANGO_LOG_LEVEL=WARNING
